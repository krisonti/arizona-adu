<!DOCTYPE html>
<html lang="en">
<head>
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18011803346"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-18011803346');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Phoenix ADU Design & Build | SOKO Designs</title>
  <meta name="description" content="Turnkey ADUs, casitas, and guest houses across the Phoenix metro. Check whether your property may qualify for a free preliminary feasibility review.">
  <meta name="robots" content="noindex,nofollow">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Turn your backyard into a second home. | SOKO Designs">
  <meta property="og:description" content="Phoenix ADUs — designed, permitted, and built by one local team.">
  <meta property="og:image" content="https://arizona-adu.netlify.app/ADU1%20Assets/1%20Bedroom%20600sf/EXTERIOR%201%20%282%29_web.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Franklin:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --cream:#f8f4ec;--ink:#1f2927;--ink-soft:#65706d;--teal:#3f7476;--teal-deep:#294f51;
      --clay:#b86c43;--clay-dark:#955335;--sand:#dfc9a6;--white:#fff;--line:#d8cdbc;
      --max:1240px;--shadow:0 24px 70px rgba(30,43,41,.18)
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{background:var(--cream);color:var(--ink);font-family:"DM Sans",Arial,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}
    body.modal-open{overflow:hidden}
    h1,h2,h3,.display{font-family:"Libre Franklin",Arial,sans-serif;line-height:.98;letter-spacing:-.035em}
    a{color:inherit}img{display:block;width:100%}.wrap{width:min(100% - 40px,var(--max));margin-inline:auto}
    .eyebrow{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 24px;border:0;border-radius:999px;background:var(--teal);color:#fff;font:700 15px/1 "DM Sans",sans-serif;text-decoration:none;cursor:pointer;transition:.2s ease}
    .btn:hover{background:var(--teal-deep);transform:translateY(-1px)}.btn-clay{background:var(--clay)}.btn-clay:hover{background:var(--clay-dark)}
    .btn:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid var(--sand);outline-offset:3px}
    .arrow{font-size:19px;margin-left:8px}.nav{position:absolute;inset:0 0 auto;z-index:20;background:rgba(248,244,236,.96);border-bottom:1px solid rgba(31,41,39,.1);backdrop-filter:blur(12px)}
    .nav-inner{height:80px;display:flex;align-items:center;justify-content:space-between;gap:28px}.logo{width:auto;height:50px}.links{display:flex;align-items:center;gap:30px;font-size:14px;font-weight:600;color:rgba(31,41,39,.68)}.links a{text-decoration:none}.links a:hover{color:var(--ink)}
    .nav-actions{display:flex;align-items:center;gap:16px}.phone{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:700;text-decoration:none}
    .hero{min-height:820px;padding-top:80px;position:relative;display:flex;align-items:center;color:#fff;overflow:hidden}
    .hero-bg{position:absolute;inset:0;background:url('../ADU1%20Assets/1%20Bedroom%20600sf/EXTERIOR%201%20%282%29_web.jpg') center/cover no-repeat}
    .hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,31,30,.94),rgba(20,31,30,.73) 49%,rgba(20,31,30,.15))}
    .hero-inner{position:relative;z-index:1;padding:90px 0 120px}.hero .eyebrow{color:var(--sand)}
    .hero h1{max-width:800px;margin-top:20px;font-size:clamp(54px,7vw,106px);line-height:.88;letter-spacing:-.05em}
    .hero-copy{max-width:650px;margin-top:28px;color:rgba(255,255,255,.82);font-size:clamp(18px,2vw,21px);line-height:1.55}
    .hero-form{display:flex;max-width:680px;margin-top:36px;padding:10px;gap:10px;border-radius:18px;background:#fff;box-shadow:0 25px 60px rgba(0,0,0,.3)}
    .address-wrap{display:flex;flex:1;align-items:center;gap:12px;min-height:58px;padding:0 14px;color:var(--ink)}.pin{color:var(--clay);font-size:21px}.address-wrap input{width:100%;border:0;background:transparent;color:var(--ink);font:500 16px "DM Sans",sans-serif;outline:0}.address-wrap input::placeholder{color:rgba(31,41,39,.45)}
    .hero-form .btn{min-height:58px;border-radius:13px;font-size:16px}.micro{margin-top:12px;color:rgba(255,255,255,.64);font-size:13px}
    .proof-wrap{position:relative;z-index:2;margin-top:-52px;padding-bottom:90px}.proof-bar{display:grid;grid-template-columns:repeat(3,1fr);overflow:hidden;border:1px solid rgba(31,41,39,.05);border-radius:20px;background:var(--cream);box-shadow:var(--shadow)}
    .proof-item{padding:24px 28px;border-right:1px solid rgba(31,41,39,.12)}.proof-item:last-child{border-right:0}.proof-value{color:var(--teal-deep);font:600 38px/1 "Libre Franklin",sans-serif;letter-spacing:-.035em}.proof-label{margin-top:8px;color:rgba(31,41,39,.55);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
    .qualify{padding:105px 0;background:var(--teal-deep);color:#fff}.qualify-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:72px;align-items:center}.qualify .eyebrow{color:var(--sand)}
    .qualify h2{max-width:580px;margin-top:17px;font-size:clamp(45px,5vw,64px)}.qualify-copy{max-width:570px;margin-top:24px;color:rgba(255,255,255,.7);font-size:18px;line-height:1.75}.checks{display:grid;gap:14px;margin-top:28px;list-style:none}.checks li{display:flex;align-items:center;gap:12px}.check{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--sand);color:var(--teal-deep);font-weight:900}
    .q-card{border-radius:28px;background:var(--cream);color:var(--ink);padding:38px;box-shadow:0 30px 70px rgba(0,0,0,.26)}.q-card .eyebrow{color:var(--clay)}.q-card h3{margin-top:12px;font-size:38px}.q-lede{margin-top:10px;color:var(--ink-soft);font-size:14px}.step-head{display:flex;align-items:center;justify-content:space-between;gap:20px}.edit{border:0;background:none;color:var(--teal);font:700 14px "DM Sans",sans-serif;text-decoration:underline;text-underline-offset:4px;cursor:pointer}
    .fields{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:26px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:13px;font-weight:700}.field input{width:100%;height:54px;border:1px solid rgba(31,41,39,.16);border-radius:12px;background:#fff;padding:0 15px;color:var(--ink);font:500 16px "DM Sans",sans-serif}.field input:focus{border-color:var(--teal);outline:3px solid rgba(63,116,118,.18)}
    .form-btn{grid-column:1/-1;width:100%;height:57px;border-radius:13px;font-size:16px}.fine{grid-column:1/-1;color:rgba(31,41,39,.5);font-size:12px;line-height:1.55;text-align:center}.status{grid-column:1/-1;color:#9d392f;font-size:14px}.address-chip{margin-top:12px;padding:10px 13px;border-radius:10px;background:#fff;color:var(--ink-soft);font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.success{text-align:center;padding:22px 4px}.success-badge{display:grid;place-items:center;width:58px;height:58px;margin:0 auto;border-radius:50%;background:rgba(63,116,118,.13);color:var(--teal);font-size:30px}.success h3{margin-top:18px}.success p{max-width:520px;margin:16px auto 0;color:var(--ink-soft);line-height:1.7}
    .section{padding:120px 0}.section-head{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end}.section .eyebrow{color:var(--clay)}.section h2{max-width:780px;margin-top:16px;font-size:clamp(48px,6vw,74px)}.section-intro{max-width:580px;color:var(--ink-soft);font-size:18px;line-height:1.75;justify-self:end}
    .models{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:52px}.model{overflow:hidden;border-radius:26px;background:#fff;box-shadow:0 14px 45px rgba(30,43,41,.08)}.model-image{position:relative;aspect-ratio:4/3;overflow:hidden}.model-image img{width:100%;height:100%;object-fit:cover;transition:transform .7s}.model:hover img{transform:scale(1.03)}.model-number{position:absolute;top:18px;left:18px;padding:6px 12px;border-radius:999px;background:rgba(248,244,236,.94);color:var(--teal-deep);font-size:12px;font-weight:700;letter-spacing:.12em}.model-body{padding:26px}.model-top{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.model h3{font-size:28px}.size{color:var(--clay);font-size:14px;font-weight:700}.best{margin-top:18px;padding-top:18px;border-top:1px solid rgba(31,41,39,.1);color:var(--ink-soft);font-size:14px}.text-link{display:inline-flex;align-items:center;margin-top:20px;border:0;background:none;color:var(--teal);font:700 14px "DM Sans",sans-serif;cursor:pointer}
    .why{padding:120px 0;background:#e8dfcf}.why-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:68px;align-items:center}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:12px}.gallery img{height:100%;object-fit:cover;border-radius:24px}.gallery .wide{grid-column:1/-1;aspect-ratio:16/9}.gallery .small{aspect-ratio:4/3}.why .eyebrow{color:var(--clay)}.why h2{margin-top:16px;font-size:clamp(48px,5vw,64px)}.why-copy{margin-top:24px;color:var(--ink-soft);font-size:18px;line-height:1.75}.why-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:32px}.why-card{padding:20px;border:1px solid rgba(31,41,39,.1);border-radius:18px;background:rgba(248,244,236,.62)}.why-card b{display:block}.why-card p{margin-top:5px;color:var(--ink-soft);font-size:13px;line-height:1.55}
    .process{padding:120px 0;background:var(--ink);color:#fff}.process .eyebrow{color:var(--sand)}.process h2{max-width:800px;margin-top:16px;font-size:clamp(48px,6vw,74px)}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin-top:52px;overflow:hidden;border-radius:26px;background:rgba(255,255,255,.14)}.step{padding:30px;background:var(--ink)}.step-num{color:rgba(255,255,255,.3);font:600 24px "Libre Franklin",sans-serif}.step h3{margin-top:40px;font-size:27px}.step p{margin-top:15px;color:rgba(255,255,255,.6);font-size:14px;line-height:1.7}
    .benefit-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.benefit-copy{color:var(--ink-soft);font-size:18px;line-height:1.75;margin-top:24px}.benefits{display:grid;grid-template-columns:1fr 1fr;gap:16px}.benefit{padding:27px;border:1px solid rgba(31,41,39,.1);border-radius:24px;background:#fff}.benefit-label{color:var(--clay);font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.benefit h3{margin-top:28px;font-size:28px}.benefit p{margin-top:10px;color:var(--ink-soft);font-size:14px;line-height:1.65}
    .faq{padding:105px 0;background:#fff;border-block:1px solid rgba(31,41,39,.1)}.faq-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:70px}.faq h2{margin-top:16px;font-size:clamp(46px,5vw,62px)}.faq-call{display:inline-flex;margin-top:28px;color:var(--teal);font-weight:700;text-decoration:none}.faq-list{border-top:1px solid rgba(31,41,39,.15)}details{border-bottom:1px solid rgba(31,41,39,.15)}summary{position:relative;list-style:none;cursor:pointer;padding:25px 46px 25px 0;font:600 22px "Libre Franklin",sans-serif;letter-spacing:-.02em}summary::-webkit-details-marker{display:none}summary::after{content:"⌄";position:absolute;right:4px;color:var(--teal);transition:.2s}details[open] summary::after{transform:rotate(180deg)}details p{max-width:760px;padding:0 40px 24px 0;color:var(--ink-soft);line-height:1.75}
    .final{position:relative;padding:112px 0;background:var(--teal-deep);color:#fff;overflow:hidden}.final::after{content:"";position:absolute;inset:0 0 0 50%;opacity:.1;background-image:radial-gradient(#fff 1px,transparent 1px);background-size:24px 24px}.final-inner{position:relative;z-index:1;display:grid;grid-template-columns:1fr auto;gap:50px;align-items:center}.final .eyebrow{color:var(--sand)}.final h2{max-width:850px;margin-top:16px;font-size:clamp(48px,6vw,74px)}.final p{max-width:680px;margin-top:22px;color:rgba(255,255,255,.68);font-size:18px}.final .btn{min-height:64px;padding:0 32px;font-size:17px}
    footer{padding:52px 0 82px;background:#14201e;color:rgba(255,255,255,.62)}.foot-top{display:flex;align-items:center;justify-content:space-between;gap:30px;padding-bottom:32px;border-bottom:1px solid rgba(255,255,255,.1)}.foot-logo{width:auto;height:66px;padding:7px;border-radius:11px;background:#fff}.foot-contact{text-align:right;font-size:14px;line-height:1.8}.foot-contact a{color:#fff;font-weight:600;text-decoration:none}.disclaimer{max-width:1030px;margin-top:28px;color:rgba(255,255,255,.38);font-size:11px;line-height:1.8}
    .mobile-bar{display:none;position:fixed;inset:auto 0 0;z-index:50;grid-template-columns:1fr 1fr;gap:8px;padding:8px;border-top:1px solid var(--line);background:#fff;box-shadow:0 -8px 30px rgba(0,0,0,.12)}.mobile-bar a{display:flex;align-items:center;justify-content:center;font-weight:700;text-decoration:none;color:var(--teal)}.mobile-bar .btn{height:50px;border-radius:12px}
    [hidden]{display:none!important}
    @media(max-width:980px){.links{display:none}.qualify-grid,.why-grid,.section-head,.benefit-grid,.faq-grid{grid-template-columns:1fr}.section-intro{justify-self:start}.models{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr 1fr}.final-inner{grid-template-columns:1fr}.final .btn{justify-self:start}.qualify-grid{gap:48px}.why-grid{gap:45px}}
    @media(max-width:680px){body{padding-bottom:66px}.wrap{width:min(100% - 30px,var(--max))}.nav-inner{height:68px}.logo{height:42px}.phone{display:none}.nav-actions .btn{min-height:42px;padding:0 16px;font-size:13px}.hero{min-height:760px;padding-top:68px}.hero-inner{padding:78px 0 110px}.hero h1{font-size:52px}.hero-copy{font-size:17px}.hero-form{flex-direction:column}.hero-form .btn{width:100%}.proof-wrap{margin-top:-42px;padding-bottom:72px}.proof-bar{grid-template-columns:1fr}.proof-item{border-right:0;border-bottom:1px solid rgba(31,41,39,.12)}.proof-item:last-child{border-bottom:0}.qualify,.section,.why,.process,.faq,.final{padding:82px 0}.q-card{padding:26px 20px}.fields,.models,.why-cards,.benefits{grid-template-columns:1fr}.field{grid-column:1/-1}.models{gap:18px}.gallery{gap:8px}.steps{grid-template-columns:1fr}.step h3{margin-top:24px}.foot-top{align-items:flex-start;flex-direction:column}.foot-contact{text-align:left}.mobile-bar{display:grid}}
  </style>
</head>
<body>
  <header class="nav">
    <div class="wrap nav-inner">
      <a href="#top" aria-label="SOKO Designs home"><img class="logo" src="../soko-designs-logo.png" alt="SOKO Designs"></a>
      <nav class="links" aria-label="Primary navigation"><a href="#models">ADU models</a><a href="#process">How it works</a><a href="#why-soko">Why SOKO</a></nav>
      <div class="nav-actions"><a class="phone" href="tel:+16028788087">602-878-8087</a><button class="btn js-check">Check my property</button></div>
    </div>
  </header>

  <main>
    <section class="hero" id="top">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <p class="eyebrow">Phoenix metro · design, permits &amp; build</p>
        <h1>Turn your backyard into a second home.</h1>
        <p class="hero-copy">SOKO makes ADUs simple—from the first property check through final inspection. One experienced local team, one clear path forward.</p>
        <form class="hero-form" id="hero-form">
          <label class="address-wrap"><span class="pin" aria-hidden="true">⌖</span><span class="sr-only" style="position:absolute;left:-9999px">Property address</span><input id="hero-address" type="text" autocomplete="street-address" placeholder="Enter your property address" required></label>
          <button class="btn btn-clay" type="submit">Check eligibility <span class="arrow">→</span></button>
        </form>
        <p class="micro">Free preliminary review · No obligation · Usually takes about a minute</p>
      </div>
    </section>

    <section class="proof-wrap" aria-label="SOKO experience">
      <div class="wrap proof-bar">
        <div class="proof-item"><div class="proof-value">100+</div><div class="proof-label">Arizona projects</div></div>
        <div class="proof-item"><div class="proof-value">40+</div><div class="proof-label">Local jurisdictions</div></div>
        <div class="proof-item"><div class="proof-value">One team</div><div class="proof-label">Design · permit · build</div></div>
      </div>
    </section>

    <section class="qualify" id="property-check">
      <div class="wrap qualify-grid">
        <div>
          <p class="eyebrow">Your free property check</p>
          <h2>Know what fits before you spend a dollar.</h2>
          <p class="qualify-copy">We review the address against local ADU rules, then outline likely size, setback, budget, and rental-income considerations.</p>
          <ul class="checks"><li><span class="check">✓</span>Parcel-specific feasibility guidance</li><li><span class="check">✓</span>Likely model and footprint options</li><li><span class="check">✓</span>Clear next steps from a local ADU team</li></ul>
        </div>

        <div class="q-card">
          <form id="step-one">
            <p class="eyebrow">Step 1 of 2</p><h3>Start with the property.</h3><p class="q-lede">We’ll only ask for contact details after we know where the project is.</p>
            <div class="fields"><div class="field full"><label for="property-address">Property address</label><input id="property-address" name="address" type="text" autocomplete="street-address" placeholder="123 E Palm Ln, Phoenix, AZ 85004" required></div><button class="btn btn-clay form-btn" type="submit">See what my property could support <span class="arrow">→</span></button><p class="fine">Preliminary guidance only. Final eligibility is confirmed during design.</p></div>
          </form>

          <form id="lead-form" hidden>
            <div class="step-head"><p class="eyebrow">Step 2 of 2</p><button class="edit" id="edit-address" type="button">Edit address</button></div>
            <h3>Where should we send the review?</h3><div class="address-chip" id="address-chip"></div>
            <div class="fields">
              <div class="field full"><label for="name">Name</label><input id="name" name="name" type="text" autocomplete="name" required></div>
              <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" required></div>
              <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required></div>
              <input name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px">
              <button class="btn btn-clay form-btn" id="lead-submit" type="submit">Send my free property review <span class="arrow">→</span></button>
              <p class="status" id="form-status" role="alert"></p><p class="fine">We’ll use your details only to review this property and discuss your ADU project.</p>
            </div>
          </form>

          <div class="success" id="success" hidden aria-live="polite"><div class="success-badge">✓</div><p class="eyebrow">Request received</p><h3>Your property is in the review queue.</h3><p>We’ll review the address and follow up with preliminary guidance. Want to talk now? Call <a href="tel:+16028788087">602-878-8087</a>.</p></div>
        </div>
      </div>
    </section>

    <section class="section" id="models">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow">Permit-ready starting points</p><h2>Three smart ways to use your lot.</h2></div><p class="section-intro">Start from a proven layout, then adapt it to your site, needs, and finish preferences. That keeps decisions focused and the path to permitting clearer.</p></div>
        <div class="models">
          <article class="model"><div class="model-image"><img src="../ADU1%20Assets/Studio/Casita%20-%20Front%20View_web.jpg" alt="Studio casita exterior by SOKO Designs"><span class="model-number">01</span></div><div class="model-body"><div class="model-top"><h3>Studio Casita</h3><span class="size">~400 sq ft</span></div><p class="best">Best for: guests, office, or flexible rental</p><button class="text-link js-check">Check fit for my lot →</button></div></article>
          <article class="model"><div class="model-image"><img src="../ADU1%20Assets/1%20Bedroom%20600sf/EXTERIOR%201%20%282%29_web.jpg" alt="One-bedroom backyard ADU by SOKO Designs"><span class="model-number">02</span></div><div class="model-body"><div class="model-top"><h3>One-Bedroom</h3><span class="size">~600 sq ft</span></div><p class="best">Best for: long-term living and rental income</p><button class="text-link js-check">Check fit for my lot →</button></div></article>
          <article class="model"><div class="model-image"><img src="../ADU1%20Assets/1%20Bedroom%20800sf/03%20EXTERIOR%201_web.jpg" alt="Two-level Phoenix ADU by SOKO Designs"><span class="model-number">03</span></div><div class="model-body"><div class="model-top"><h3>Two-Level</h3><span class="size">~800 sq ft</span></div><p class="best">Best for: more living space on a smaller footprint</p><button class="text-link js-check">Check fit for my lot →</button></div></article>
        </div>
      </div>
    </section>

    <section class="why" id="why-soko">
      <div class="wrap why-grid">
        <div class="gallery"><img class="wide" src="../ADU1%20Assets/1%20Bedroom%20600sf/MAIN%20AREA%202%20%281%29_web.jpg" alt="Warm modern ADU living space"><img class="small" src="../ADU1%20Assets/Studio/Casita%20-%20Interior%201_web.jpg" alt="Studio casita interior"><img class="small" src="../ADU1%20Assets/1%20Bedroom%20800sf/04%20MAIN%20AREA%201_web.jpg" alt="Two-level ADU interior"></div>
        <div><p class="eyebrow">Why SOKO</p><h2>One accountable team from idea to keys.</h2><p class="why-copy">ADU projects get difficult when design, permitting, and construction are fragmented. SOKO connects the entire process, so each decision supports what comes next.</p><div class="why-cards"><div class="why-card"><b>Local code experience</b><p>Work across 40+ Arizona jurisdictions.</p></div><div class="why-card"><b>Designed to be built</b><p>Plans shaped by real site and construction constraints.</p></div><div class="why-card"><b>Fewer handoffs</b><p>One team coordinates permits, build, and inspections.</p></div><div class="why-card"><b>Clear ownership</b><p>You always know who is responsible for the next step.</p></div></div></div>
      </div>
    </section>

    <section class="process" id="process">
      <div class="wrap"><p class="eyebrow">A clearer ADU process</p><h2>Four milestones. One team running the work.</h2><div class="steps"><article class="step"><div class="step-num">01</div><h3>Check the property</h3><p>We review likely zoning, space, access, utilities, and the model that may fit.</p></article><article class="step"><div class="step-num">02</div><h3>Shape the plan</h3><p>We adapt the right starting design to your parcel and project goals.</p></article><article class="step"><div class="step-num">03</div><h3>Run permitting</h3><p>SOKO prepares the package, coordinates comments, and keeps approvals moving.</p></article><article class="step"><div class="step-num">04</div><h3>Build to completion</h3><p>Construction, inspections, and the final handoff stay with the same team.</p></article></div></div>
    </section>

    <section class="section">
      <div class="wrap benefit-grid"><div><p class="eyebrow">What an ADU can unlock</p><h2>More useful space on land you already own.</h2><p class="benefit-copy">The right ADU can solve an immediate family need while adding long-term flexibility to your property.</p></div><div class="benefits"><article class="benefit"><span class="benefit-label">Income</span><h3>Rental income</h3><p>Create a separate long-term rental opportunity, subject to local rules.</p></article><article class="benefit"><span class="benefit-label">Family</span><h3>Family housing</h3><p>Keep parents, adult children, or guests close with more independence.</p></article><article class="benefit"><span class="benefit-label">Flexibility</span><h3>Flexible space</h3><p>Use it as a guest suite, office, or future downsizing option.</p></article><article class="benefit"><span class="benefit-label">Property</span><h3>Property utility</h3><p>Add functional living space without buying another parcel.</p></article></div></div>
    </section>

    <section class="faq"><div class="wrap faq-grid"><div><p class="eyebrow">Common questions</p><h2>Straight answers before you start.</h2><a class="faq-call" href="tel:+16028788087">Talk with SOKO: 602-878-8087</a></div><div class="faq-list"><details><summary>Will my property qualify?</summary><p>Many Phoenix-area single-family lots can support an ADU, but size, setbacks, utilities, and local rules are parcel-specific. We confirm the practical constraints before you commit to design.</p></details><details><summary>How much does an ADU cost?</summary><p>Budget depends on model, site access, utility runs, finish choices, and jurisdiction. Your free property review gives us enough context to outline a realistic starting range instead of an unhelpful generic number.</p></details><details><summary>How long does the process take?</summary><p>Timing varies by city and property. SOKO manages design, permit coordination, construction, and inspections as one connected process.</p></details><details><summary>Can I rent the ADU?</summary><p>Long-term rental is a common use for Phoenix-area ADUs. City rules and your property details still matter, so we include rental-use considerations in the feasibility conversation.</p></details><details><summary>Do you work with out-of-state owners?</summary><p>Yes. Plans, selections, approvals, progress updates, inspections, and construction are coordinated through one local team.</p></details></div></div></section>

    <section class="final"><div class="wrap final-inner"><div><p class="eyebrow">Your first step is free</p><h2>Let’s see what your property could support.</h2><p>Share the address. We’ll help turn the rules, setbacks, and possibilities into a practical next step.</p></div><button class="btn btn-clay js-check">Check my property <span class="arrow">→</span></button></div></section>
  </main>

  <footer><div class="wrap"><div class="foot-top"><img class="foot-logo" src="../soko-designs-logo.png" alt="SOKO Designs"><div class="foot-contact">Phoenix, Arizona<br><a href="tel:+16028788087">602-878-8087</a> · <a href="mailto:kris@sokodesigns.com">kris@sokodesigns.com</a></div></div><p class="disclaimer">Preliminary guidance only. ADU eligibility, size, setbacks, cost, timing, rental use, and financing depend on current laws, local ordinances, parcel conditions, utilities, selections, and project review. Images are representative renderings. © SOKO Designs.</p></div></footer>

  <div class="mobile-bar"><a href="tel:+16028788087">Call SOKO</a><button class="btn btn-clay js-check">Check my property</button></div>

  <script>
    (function(){
      const CONVERSION_ID = 'AW-18011803346/n7LnCOfjjNAcENKd2YxD';
      const heroForm = document.getElementById('hero-form');
      const heroAddress = document.getElementById('hero-address');
      const stepOne = document.getElementById('step-one');
      const propertyAddress = document.getElementById('property-address');
      const leadForm = document.getElementById('lead-form');
      const addressChip = document.getElementById('address-chip');
      const submit = document.getElementById('lead-submit');
      const status = document.getElementById('form-status');
      const success = document.getElementById('success');
      const params = new URLSearchParams(location.search);

      function scrollToCheck(){ document.getElementById('property-check').scrollIntoView({behavior:'smooth'}); }
      function showContact(){
        if(!propertyAddress.value.trim()){ propertyAddress.focus(); return; }
        stepOne.hidden = true; leadForm.hidden = false; addressChip.textContent = '⌖  ' + propertyAddress.value.trim();
        if(typeof gtag === 'function') gtag('event','property_check_start',{page_variant:'B'});
        setTimeout(()=>document.getElementById('name').focus(),250);
      }
      document.querySelectorAll('.js-check').forEach(btn=>btn.addEventListener('click',scrollToCheck));
      heroForm.addEventListener('submit',function(e){e.preventDefault();propertyAddress.value=heroAddress.value.trim();scrollToCheck();setTimeout(showContact,450)});
      stepOne.addEventListener('submit',function(e){e.preventDefault();showContact()});
      document.getElementById('edit-address').addEventListener('click',function(){leadForm.hidden=true;stepOne.hidden=false;propertyAddress.focus()});

      leadForm.addEventListener('submit',async function(e){
        e.preventDefault();status.textContent='';submit.disabled=true;submit.textContent='Sending…';
        const formData = Object.fromEntries(new FormData(leadForm).entries());
        const payload = {
          ...formData,address:propertyAddress.value.trim(),variant:'B',source:'Google Ads landing page — B',
          leadSource:(params.get('gclid') || (params.get('utm_source')||'').toLowerCase()==='google') ? 'Paid Ad - Google' : 'Other',
          gclid:params.get('gclid')||'',utm_source:params.get('utm_source')||'',utm_campaign:params.get('utm_campaign')||'',utm_content:params.get('utm_content')||'',utm_term:params.get('utm_term')||''
        };
        try{
          const response = await fetch('/.netlify/functions/qualify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
          const result = await response.json().catch(()=>({}));
          if(!response.ok || !result.ok) throw new Error('Submission failed');
          if(typeof gtag === 'function'){
            gtag('event','conversion',{send_to:CONVERSION_ID,event_callback:function(){}});
            gtag('event','generate_lead',{page_variant:'B',lead_source:payload.leadSource});
          }
          leadForm.hidden=true;success.hidden=false;
        }catch(error){
          status.innerHTML='We couldn’t send this right now. Please call <a href="tel:+16028788087">602-878-8087</a> or email <a href="mailto:kris@sokodesigns.com">kris@sokodesigns.com</a>.';
          submit.disabled=false;submit.textContent='Send my free property review →';
        }
      });
    })();
  </script>
</body>
</html>
